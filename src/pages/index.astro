---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Card from "../components/Card.astro";
import CardGrid from "../components/CardGrid.astro";
import HeroBanner from "../components/HeroBanner.astro";
import FAQ from "../components/FAQ.astro";
import CTAButton from "../components/CTAButton.astro";
import CTAStrip from "../components/CTAStrip.astro";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />

	</head>
<Header />

<HeroBanner
  title="Good Food. Warm Welcome. Community First."
  subtitle="We provide welcoming community meals in Loughborough for anyone who needs one — no questions asked."
  primaryCtaText="When & Where"
  primaryCtaLink="#when-where"
  secondaryCtaText="Volunteer With Us"
  secondaryCtaLink="/volunteer"
  imageSrc="/images/LCK\ Banner\ Hero.jpeg"
  imageAlt="Community volunteers posing in the kitchen"
/>

	<body>
		
		<main>

			  <section id="about">
			    <h2>Welcome</h2>
			    <p>
			      We’re a volunteer-run group providing <strong>free or low-cost hot meals</strong> to anyone in need.
			      Our aim is simple: good food, friendly faces, and a warm welcome—no questions asked.
			    </p>
			  </section>


			<section class="features">
 				<h2>How You Can Get Involved</h2>

			  <CardGrid>
			    <Card
			      title="Community Meals"
			      description="Free, welcoming meals for anyone who needs one."
			      href="/meals"
			      image="/images/square_roast_dinner.png"
			    />
			
			    <Card
			      title="Volunteer"
			      description="Help cook, serve, or support behind the scenes."
			      href="/volunteer"
			      image="/images/square_volunteer.png"
			    />
			
			    <Card
			      title="Donate or Sponsor"
			      description="Support our work and help us serve more meals."
			      href="/donate"
			      image="/images/square_casserole.png"
			    />
			  </CardGrid>
			</section>


<section id="faq" class="faq-section">
  <h2>Frequently Asked Questions</h2>

  <FAQ 
    question="When and where?"
    answer='1pm Service on Sundays (Fortnightly), at Loughborough United Reformed Church. \n
	For more info see <a href = "/findus>" <a>'
  />

  <FAQ 
    question="Do I need to book a meal?"
    answer="No — just turn up. All are welcome, whatever your circumstances."
  />

  <FAQ
    question="Can families come?"
    answer="Yes! We welcome families"
  />

  <FAQ
    question="How do I volunteer?"
    answer="Fill out our volunteer form and we'll contact you with next steps."
  />

  <FAQ
    question="Is it free?"
    answer="Yes. All meals are free for anyone in need, no questions asked."
  />
</section>
	



<CTAStrip>
  <CTAButton text="Volunteer Today" href="/volunteer" variant="primary" />
  <CTAButton text="Donate / Sponsor" href="/donate" variant="secondary" />
</CTAStrip>

		</main>
		<Footer />
	</body>
</html>
